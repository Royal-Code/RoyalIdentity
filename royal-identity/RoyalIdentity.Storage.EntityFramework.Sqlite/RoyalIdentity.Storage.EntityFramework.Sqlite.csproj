<Project Sdk="Microsoft.NET.Sdk">

	<!--
		SQLite provider for the core storage families: provider refinements, contexts and migrations for
		Configuration and Operational.
	-->
	<ItemGroup>
		<ProjectReference Include="..\RoyalIdentity.Storage.EntityFramework\RoyalIdentity.Storage.EntityFramework.csproj" />
		<ProjectReference Include="..\RoyalIdentity.Data.Configuration\RoyalIdentity.Data.Configuration.csproj" />
		<ProjectReference Include="..\RoyalIdentity.Data.Operational\RoyalIdentity.Data.Operational.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVer)" />
		<!-- Promote the transitive SQLitePCLRaw native bundle past the 2.1.11 advisory (NU1903). -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqliteVer)" />
		<!-- Design-time tooling only (dotnet ef migrations): not part of the shipped runtime surface. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVer)" PrivateAssets="all" />
	</ItemGroup>

</Project>
