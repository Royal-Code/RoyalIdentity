{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RoyalIdentity": {
    "Connections": {
      "Configuration": {
        "ConnectionString": ""
      },
      "Operational": {
        "ConnectionString": ""
      },
      "UserAccounts": {
        "ConnectionString": ""
      }
    },
    "Snapshot": {
      "RefreshInterval": "00:05:00"
    },
    "Cleanup": {
      "Mode": "External",
      "Interval": "00:15:00",
      "BatchSize": 500
    },
    "DataProtection": {
      "KeyRingPath": "data-protection-keys",
      "ApplicationName": "RoyalIdentity.Server",
      "OperationalPayloadProfileId": "default"
    },
    "UserAccounts": {
      "Options": {
        "Defaults": {},
        "Realms": {}
      }
    }
  },
  "AllowedHosts": "*"
}
