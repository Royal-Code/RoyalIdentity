@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using System.Reflection
@using Microsoft.Extensions.Localization
@using RoyalIdentity.Razor.Localization

@typeparam TValue

@inject IStringLocalizer<ValidationResources> V

@foreach (var message in messages)
{
    <div class="validation-message text-danger">@message</div>
}

@code {
    private List<string> messages = [];

    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    /// <summary>
    /// The field this message belongs to, in the same form the framework's <c>ValidationMessage</c> takes.
    /// </summary>
    [Parameter, EditorRequired]
    public Expression<Func<TValue>> For { get; set; } = default!;

    /// <summary>
    /// Renders this field's validation messages in the request's culture.
    /// </summary>
    /// <remarks>
    /// The framework's <c>ValidationMessage</c> prints whatever DataAnnotations produced, which here is the
    /// catalogue key — so the field-level message would show <c>Validation_Required</c> beside the input even
    /// while the summary showed the translation. Resolving the key and the field's display name together is
    /// what keeps the two consistent.
    /// </remarks>
    protected override void OnParametersSet()
    {
        messages = [];

        if (EditContext is null)
            return;

        var field = FieldIdentifier.Create(For);
        var property = field.Model.GetType().GetProperty(field.FieldName);

        foreach (var raw in EditContext.GetValidationMessages(field))
            messages.Add(Localize(raw, property));
    }

    private string Localize(string raw, PropertyInfo? property)
    {
        if (!raw.StartsWith("Validation_", StringComparison.Ordinal))
            return raw;

        var displayKey = property?.GetCustomAttribute<DisplayAttribute>()?.Name;
        var displayName = displayKey is null ? property?.Name ?? string.Empty : V[displayKey].Value;

        return string.Format(V[raw].Value, displayName);
    }
}
