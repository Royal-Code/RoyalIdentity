@using Microsoft.Extensions.Localization
@using RoyalIdentity.Razor.Localization

@inject IStringLocalizer<AccountResources> L

@attribute [Route(Routes.SelectDomain)]

@using RoyalIdentity.Contracts.Storage

@inject IStorage storage;
@inject NavigationManager NavigationManager

<PageTitle>@L["Domain_Title"]</PageTitle>

<AccountContent>
    <Title>
        <h1>@L["Domain_Title"]</h1>
    </Title>
    <ChildContent>
        <StatusMessage Message="@errorMessage" MessageClass="danger" />
        <EditForm Model="Input" method="post" OnValidSubmit="SelectDomain" FormName="select-domain">
            <DataAnnotationsValidator/>
            <LocalizedValidationSummary />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Domain" class="form-control" id="Domain" aria-required="true" placeholder="@L["Domain_Placeholder"]" auto-focus />
                <label for="Domain" class="form-label">@L["Domain_Label"]</label>
                <LocalizedValidationMessage For="() => Input.Domain" />
            </div>

            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">@L["Common_Continue"]</button>
            </div>

        </EditForm>

    </ChildContent>
</AccountContent>

@code {
    private string? errorMessage;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    public DomainInput Input { get; set; } = new();

    public async Task SelectDomain()
    {
        if (Input.Domain is null)
        {
            errorMessage = L["Domain_NotFound"];
            return;
        }

        var realm = await storage.Realms.GetByDomainAsync(Input.Domain);

        if (realm is null)
        {
            errorMessage = L["Domain_NotFound"];
            return;
        }

        var returnUrl = ReturnUrl ?? Routes.BuildProfileUrl(realm.Path);

        // Redirect to the realm's login page
        NavigationManager.NavigateTo(Routes.BuildLoginUrl(realm.Path, returnUrl));
    }
}
