@using Microsoft.Extensions.Localization
@using RoyalIdentity.Razor.Localization

@inject IStringLocalizer<AccountResources> L

@attribute [Route(Routes.SignedIn)]

<PageTitle>@L["SignedIn_Title"]</PageTitle>

<AccountContent>
    <div class="signed-in-container">
        <div class="signed-in-message">
            <h2>@L["SignedIn_WelcomeBack"]</h2>
            <p>@L["SignedIn_Success"]</p>
            <p>@L["SignedIn_ReturnToApplication"]</p>
        </div>
    </div>
</AccountContent>

@code {

    [Parameter]
    public string Realm { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

}