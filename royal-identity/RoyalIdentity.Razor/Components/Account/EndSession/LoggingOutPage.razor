@using Microsoft.Extensions.Localization
@using RoyalIdentity.Razor.Localization

@inject IStringLocalizer<AccountResources> L

@attribute [Route(Routes.LoggingOut)]

@using RoyalIdentity.Extensions

@inject IEndSessionPageService EndSessionPageService
@inject NavigationManager NavigationManager

<PageTitle>@L["Logout_LoggingOutTitle"]</PageTitle>

<AccountContent>
    <Title>
        <h1>@L["Logout_LoggingOutTitle"]</h1>
    </Title>
    <ChildContent>
        <div>
            @L["Logout_Processing"]
        </div>
        <div>
            <a class="@ClickCssClasses" href="@RedirectUrl">@ReturnMessage</a>
        </div>
        @if (model?.HasFrontChannel is true)
        {
            <iframe width="0" height="0" class="sign-out" src="@model.SignOutIframeUrl.AddQueryString(Oidc.Routes.Params.CallbackId, LogoutId!)"></iframe>
        }
    </ChildContent>
</AccountContent>

@code {

    private LoggingOutViewModel? model;

    private string ClickCssClasses => $"post-logout-redirect-uri{(model?.AutomaticRedirectAfterSignOut is true ? " automatic-redirect" : "")}";

    private string RedirectUrl => model?.PostLogoutRedirectUri ?? Routes.BuildLoggedOutUrl(Realm);

    private string ReturnMessage => model?.ClientName.IsPresent() is true
        ? L["Logout_ReturnToClient", model.ClientName!]
        : L["Logout_ReturnToApplication"];

    [Parameter]
    public string Realm { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? LogoutId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (LogoutId is null)
        {
            NavigationManager.NavigateTo(Routes.Error);
            return;
        }

        model = await EndSessionPageService.BuildLoggingOutAsync(LogoutId, CancellationToken.None);

        if (model is null)
            NavigationManager.NavigateTo(Routes.Error);
    }
}
