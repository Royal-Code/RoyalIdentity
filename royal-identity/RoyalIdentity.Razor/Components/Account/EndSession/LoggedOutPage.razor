@using Microsoft.Extensions.Localization
@using RoyalIdentity.Razor.Localization

@inject IStringLocalizer<AccountResources> L

@attribute [Route(Routes.LoggedOut)]

<AccountContent>
    <Title>
        <h1>@L["Logout_LoggedOutTitle"]</h1>
    </Title>
    <ChildContent>
        <div>
            @L["Logout_LoggedOutMessage"]
        </div>
    </ChildContent>
</AccountContent>

@code {
    [Parameter]
    public string Realm { get; set; } = default!;
}