@using Microsoft.Extensions.Localization
@using RoyalIdentity.Razor.Localization

@inject IStringLocalizer<AccountResources> L

@attribute [Route(Routes.Profile)]
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using RoyalIdentity.Extensions

<PageTitle>@L["Profile_Title"]</PageTitle>

<h1>@L["Profile_Title"]</h1>

<AuthorizeView>

    <h2>
        @L["Profile_Greeting", context.User.GetDisplayName()]
    </h2>

    <div>
        <div>@L["Profile_UserInformation"]</div>
        <div>
            @foreach(var claim in context.User.Claims)
            {
                <div>@claim.Type: @claim.Value</div>
            }
        </div>
    </div>

</AuthorizeView>

@code {
    [Parameter]
    public string Realm { get; set; } = default!;

}